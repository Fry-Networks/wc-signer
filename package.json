{
  "name": "wc-signer",
  "version": "2.0.0",
  "description": "Local web server for signing Algorand transactions with Pera Wallet",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/server.ts",
    "bundle": "esbuild src/browser-entry.ts --bundle --outfile=src/public/bundle.js --format=iife --platform=browser --target=es2020 --minify --define:global=window --define:process.env.NODE_ENV=\"production\""
  },
  "dependencies": {
    "@perawallet/connect": "^1.4.5",
    "@walletconnect/sign-client": "^2.23.9",
    "algosdk": "^3.0.0",
    "buffer": "^6.0.3",
    "commander": "^12.0.0",
    "esbuild": "^0.27.4",
    "express": "^4.21.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
