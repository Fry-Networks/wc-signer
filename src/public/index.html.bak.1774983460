<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FryGovernance Admin</title>
  <style>
    :root {
      --bg-primary: #1a1a2e;
      --bg-secondary: #16213e;
      --bg-card: #0f3460;
      --accent: #e74c3c;
      --accent-hover: #c0392b;
      --text: #eee;
      --text-muted: #888;
      --success: #27ae60;
      --warning: #f39c12;
      --error: #e74c3c;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
      background: var(--bg-primary);
      color: var(--text);
      min-height: 100vh;
      padding: 2rem;
    }

    .container {
      max-width: 600px;
      margin: 0 auto;
    }

    h1 {
      text-align: center;
      margin-bottom: 0.5rem;
      color: var(--accent);
    }

    .subtitle {
      text-align: center;
      color: var(--text-muted);
      margin-bottom: 2rem;
    }

    .card {
      background: var(--bg-secondary);
      border-radius: 12px;
      padding: 1.5rem;
      margin-bottom: 1rem;
    }

    .card-title {
      font-size: 0.875rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.75rem;
    }

    .address {
      font-family: 'SF Mono', Monaco, 'Courier New', monospace;
      font-size: 0.875rem;
      word-break: break-all;
      background: var(--bg-primary);
      padding: 0.75rem;
      border-radius: 6px;
    }

    .address.connected {
      border-left: 3px solid var(--success);
    }

    .address.expected {
      border-left: 3px solid var(--text-muted);
    }

    .status {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 0.5rem;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--text-muted);
    }

    .status-dot.connected {
      background: var(--success);
    }

    .status-dot.error {
      background: var(--error);
    }

    button {
      background: var(--accent);
      color: white;
      border: none;
      padding: 0.875rem 1.5rem;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      width: 100%;
      transition: background 0.2s;
    }

    button:hover:not(:disabled) {
      background: var(--accent-hover);
    }

    button:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    button.secondary {
      background: var(--bg-card);
    }

    button.secondary:hover:not(:disabled) {
      background: #1a4a80;
    }

    .network-selector {
      display: flex;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .network-option {
      flex: 1;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem;
      background: var(--bg-primary);
      border-radius: 6px;
      cursor: pointer;
    }

    .network-option input {
      accent-color: var(--accent);
    }

    .network-option label {
      cursor: pointer;
    }

    select, input[type="text"], input[type="number"] {
      width: 100%;
      padding: 0.75rem;
      background: var(--bg-primary);
      border: 1px solid var(--bg-card);
      border-radius: 6px;
      color: var(--text);
      font-size: 1rem;
      margin-bottom: 1rem;
    }

    select:focus, input:focus {
      outline: none;
      border-color: var(--accent);
    }

    .form-group {
      margin-bottom: 1rem;
    }

    .form-group label {
      display: block;
      font-size: 0.875rem;
      color: var(--text-muted);
      margin-bottom: 0.5rem;
    }

    .form-group small {
      display: block;
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 0.25rem;
    }

    .log-area {
      background: var(--bg-primary);
      border-radius: 6px;
      padding: 1rem;
      max-height: 200px;
      overflow-y: auto;
      font-family: 'SF Mono', Monaco, 'Courier New', monospace;
      font-size: 0.75rem;
    }

    .log-entry {
      margin-bottom: 0.25rem;
      line-height: 1.4;
    }

    .log-entry.info {
      color: var(--text-muted);
    }

    .log-entry.success {
      color: var(--success);
    }

    .log-entry.error {
      color: var(--error);
    }

    .log-entry.warn {
      color: var(--warning);
    }

    .result {
      text-align: center;
      padding: 2rem;
    }

    .result h2 {
      color: var(--success);
      margin-bottom: 1rem;
    }

    .result-value {
      font-size: 1.5rem;
      font-weight: bold;
      color: var(--success);
      margin-bottom: 1rem;
      font-family: 'SF Mono', Monaco, 'Courier New', monospace;
      word-break: break-all;
    }

    .result-details {
      font-size: 0.875rem;
      color: var(--text-muted);
    }

    .error-box {
      background: rgba(231, 76, 60, 0.1);
      border: 1px solid var(--error);
      border-radius: 6px;
      padding: 1rem;
      margin-top: 1rem;
      color: var(--error);
    }

    .hidden {
      display: none !important;
    }

    .button-group {
      display: flex;
      gap: 0.5rem;
      margin-top: 1rem;
    }

    .button-group button {
      flex: 1;
    }

    .operation-info {
      background: var(--bg-primary);
      border-radius: 6px;
      padding: 0.75rem;
      margin-bottom: 1rem;
      font-size: 0.875rem;
      color: var(--text-muted);
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>FryGovernance Admin</h1>
    <p class="subtitle">Sign transactions with Pera Wallet</p>

    <!-- Expected Admin -->
    <div class="card">
      <div class="card-title">Admin Wallet</div>
      <div class="address expected" id="expected-address">Loading...</div>
    </div>

    <!-- Connection Status -->
    <div class="card">
      <div class="card-title">Wallet Connection</div>
      <div id="connection-status">
        <div class="status">
          <div class="status-dot" id="status-dot"></div>
          <span id="status-text">Not connected</span>
        </div>
        <div class="address connected hidden" id="connected-address"></div>
      </div>
      <div class="button-group">
        <button id="connect-btn">Connect Pera Wallet</button>
        <button id="disconnect-btn" class="secondary hidden">Disconnect</button>
      </div>
    </div>

    <!-- Operations Section -->
    <div class="card hidden" id="operations-section">
      <div class="card-title">Execute Operation</div>

      <div class="network-selector">
        <div class="network-option">
          <input type="radio" name="network" id="net-testnet" value="testnet" checked>
          <label for="net-testnet">Testnet</label>
        </div>
        <div class="network-option">
          <input type="radio" name="network" id="net-mainnet" value="mainnet">
          <label for="net-mainnet">Mainnet</label>
        </div>
      </div>

      <div class="form-group">
        <label for="operation-select">Operation</label>
        <select id="operation-select">
          <option value="deploy">Deploy Contract</option>
          <option value="create-fry-asa">Create FRY ASA (Testnet)</option>
          <option value="opt-in-fry">Opt Contract into FRY</option>
          <option value="set-min-balance">Set Min Balance</option>
          <option value="fund-contract">Fund Contract</option>
          <option value="create-vote">Create Vote</option>
          <option value="close-vote">Close Vote</option>
        </select>
      </div>

      <div class="operation-info" id="operation-info">
        Deploy the FryGovernance contract to the selected network.
      </div>

      <!-- Dynamic Form Fields -->
      <div id="form-fields">
        <!-- Deploy fields -->
        <div id="fields-deploy">
          <div class="form-group">
            <label for="fry-asa-id">FRY ASA ID</label>
            <input type="text" id="fry-asa-id" placeholder="e.g., 2485314946">
            <small>The FRY token ASA ID for this network</small>
          </div>
        </div>

        <!-- Create FRY ASA fields -->
        <div id="fields-create-fry-asa" class="hidden">
          <div class="form-group">
            <label>Token Parameters</label>
            <small>Creates 10M FRY tokens with 6 decimals</small>
          </div>
        </div>

        <!-- Opt-in FRY fields -->
        <div id="fields-opt-in-fry" class="hidden">
          <div class="form-group">
            <label for="opt-app-id">Contract App ID</label>
            <input type="number" id="opt-app-id" placeholder="e.g., 758020012">
          </div>
          <div class="form-group">
            <label for="opt-fry-id">FRY ASA ID</label>
            <input type="number" id="opt-fry-id" placeholder="e.g., 12345678">
          </div>
        </div>

        <!-- Set Min Balance fields -->
        <div id="fields-set-min-balance" class="hidden">
          <div class="form-group">
            <label for="minbal-app-id">Contract App ID</label>
            <input type="number" id="minbal-app-id" placeholder="e.g., 758020012">
          </div>
          <div class="form-group">
            <label for="min-balance">Min Balance (microFRY)</label>
            <input type="number" id="min-balance" placeholder="e.g., 1000000" value="1000000">
            <small>1,000,000 = 1 FRY (6 decimals)</small>
          </div>
        </div>

        <!-- Fund Contract fields -->
        <div id="fields-fund-contract" class="hidden">
          <div class="form-group">
            <label for="fund-app-id">Contract App ID</label>
            <input type="number" id="fund-app-id" placeholder="e.g., 758020012">
          </div>
          <div class="form-group">
            <label for="fund-amount">Amount (microALGO)</label>
            <input type="number" id="fund-amount" placeholder="e.g., 10000000" value="10000000">
            <small>10,000,000 = 10 ALGO</small>
          </div>
        </div>

        <!-- Create Vote fields -->
        <div id="fields-create-vote" class="hidden">
          <div class="form-group">
            <label for="vote-app-id">Contract App ID</label>
            <input type="number" id="vote-app-id" placeholder="e.g., 758020012">
          </div>
          <div class="form-group">
            <label for="vote-name">Vote Name/ID</label>
            <input type="text" id="vote-name" placeholder="e.g., FIP-001">
            <small>Will be hashed to create 32-byte vote ID</small>
          </div>
          <div class="form-group">
            <label for="vote-type">Vote Type</label>
            <select id="vote-type">
              <option value="0">FIP (6-month lock)</option>
              <option value="1">cFIP (6-month lock)</option>
              <option value="2">Temperature Check (no lock)</option>
            </select>
          </div>
          <div class="form-group">
            <label for="vote-options">Number of Options</label>
            <input type="number" id="vote-options" value="3" min="2" max="8">
            <small>2-8 options</small>
          </div>
          <div class="form-group">
            <label for="vote-duration">Duration (days)</label>
            <input type="number" id="vote-duration" value="30" min="1">
          </div>
          <div class="form-group">
            <label for="vote-lock">Lock Duration (seconds)</label>
            <input type="number" id="vote-lock" value="15768000">
            <small>15,768,000 = 6 months. Set to 60 for quick testing.</small>
          </div>
        </div>

        <!-- Close Vote fields -->
        <div id="fields-close-vote" class="hidden">
          <div class="form-group">
            <label for="close-app-id">Contract App ID</label>
            <input type="number" id="close-app-id" placeholder="e.g., 758020012">
          </div>
          <div class="form-group">
            <label for="close-vote-name">Vote Name/ID</label>
            <input type="text" id="close-vote-name" placeholder="e.g., FIP-001">
            <small>Same name used when creating the vote</small>
          </div>
        </div>
      </div>

      <button id="execute-btn">Execute</button>
    </div>

    <!-- Log Area -->
    <div class="card">
      <div class="card-title">Activity Log</div>
      <div class="log-area" id="log-area">
        <div class="log-entry info">Waiting for wallet connection...</div>
      </div>
    </div>

    <!-- Error Display -->
    <div class="error-box hidden" id="error-box"></div>

    <!-- Success Result -->
    <div class="card hidden" id="result-section">
      <div class="result">
        <h2 id="result-title">Success!</h2>
        <div class="result-value" id="result-value"></div>
        <div class="result-details">
          <div>Transaction: <span id="result-txid"></span></div>
          <div>Confirmed Round: <span id="result-round"></span></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Error handlers for debugging module load failures
    window.addEventListener('error', function(e) {
      console.error('[wc-signer] Uncaught error:', e.error || e.message);
    });
    window.addEventListener('unhandledrejection', function(e) {
      console.error('[wc-signer] Unhandled rejection:', e.reason);
    });
  </script>

  <script>
    // Polyfills for Node.js globals that WalletConnect may reference
    if (typeof global === 'undefined') { window.global = window; }
    if (typeof process === 'undefined') { window.process = { env: { NODE_ENV: 'production' } }; }
  </script>

  <script src="/bundle.js"></script>
  <script>
    // PeraWalletConnect, algosdk, and sha512_256 are now globals from bundle.js
    const { PeraWalletConnect, sha512_256 } = window;
    const algosdk = window.algosdk;

    // Verify modules loaded
    console.log("[wc-signer] Modules loaded:", { algosdk: !!algosdk, PeraWalletConnect: !!PeraWalletConnect });

    // ==========================================================================
    // Constants
    // ==========================================================================

    const VOTE_BOX_MBR = 104100n;  // microAlgos for vote box (BigInt for algosdk v3)
    const STAKE_BOX_MBR = 61700n;  // microAlgos for stake box (BigInt for algosdk v3)
    const VOTE_BOX_PREFIX = new Uint8Array([0x76]); // "v"

    // Operation descriptions
    const OPERATION_INFO = {
      "deploy": "Deploy the FryGovernance contract to the selected network.",
      "create-fry-asa": "Create a test FRY token on testnet (10M supply, 6 decimals).",
      "opt-in-fry": "Opt the contract into the FRY ASA so it can receive tokens.",
      "set-min-balance": "Set minimum FRY balance required for temperature check voting.",
      "fund-contract": "Send ALGO to the contract for box storage costs.",
      "create-vote": "Create a new vote (FIP, cFIP, or Temperature Check).",
      "close-vote": "Close a vote (admin only, prevents further voting)."
    };

    // ==========================================================================
    // State
    // ==========================================================================

    let config = null;
    let abiSpec = null;
    let peraWallet = null;
    let connectedAddress = null;

    // Network configuration for Pera Wallet
    const NETWORK_CONFIG = {
      testnet: { network: "testnet", chainId: 416002 },
      mainnet: { network: "mainnet", chainId: 416001 }
    };

    // ==========================================================================
    // DOM Elements
    // ==========================================================================

    const expectedAddressEl = document.getElementById("expected-address");
    const statusDotEl = document.getElementById("status-dot");
    const statusTextEl = document.getElementById("status-text");
    const connectedAddressEl = document.getElementById("connected-address");
    const connectBtn = document.getElementById("connect-btn");
    const disconnectBtn = document.getElementById("disconnect-btn");
    const operationsSectionEl = document.getElementById("operations-section");
    const operationSelectEl = document.getElementById("operation-select");
    const operationInfoEl = document.getElementById("operation-info");
    const executeBtn = document.getElementById("execute-btn");
    const logAreaEl = document.getElementById("log-area");
    const errorBoxEl = document.getElementById("error-box");
    const resultSectionEl = document.getElementById("result-section");
    const resultTitleEl = document.getElementById("result-title");
    const resultValueEl = document.getElementById("result-value");
    const resultTxidEl = document.getElementById("result-txid");
    const resultRoundEl = document.getElementById("result-round");

    // ==========================================================================
    // Logging
    // ==========================================================================

    function log(message, level = "info") {
      const entry = document.createElement("div");
      entry.className = `log-entry ${level}`;
      entry.textContent = `[${new Date().toLocaleTimeString()}] ${message}`;
      logAreaEl.appendChild(entry);
      logAreaEl.scrollTop = logAreaEl.scrollHeight;
    }

    function showError(message) {
      errorBoxEl.textContent = message;
      errorBoxEl.classList.remove("hidden");
      log(message, "error");
    }

    function hideError() {
      errorBoxEl.classList.add("hidden");
    }

    // ==========================================================================
    // Helpers
    // ==========================================================================

    function getSelectedNetwork() {
      return document.querySelector('input[name="network"]:checked').value;
    }

    function getAlgodClient(network) {
      const algodUrl = config.algodEndpoints[network];
      return new algosdk.Algodv2("", algodUrl, "");
    }

    function sha256(data) {
      // Use sha512_256 from js-sha512 (algosdk v3 removed nacl.genericHash)
      return new Uint8Array(sha512_256.array(data));
    }

    function makeVoteId(name) {
      const encoder = new TextEncoder();
      return sha256(encoder.encode(name));
    }

    function encodeUint64(value) {
      const bytes = new Uint8Array(8);
      const view = new DataView(bytes.buffer);
      view.setBigUint64(0, BigInt(value), false); // big-endian
      return bytes;
    }

    function getMethodSelector(methodSignature) {
      // Method selector = first 4 bytes of sha512_256(method_signature)
      const encoder = new TextEncoder();
      const hash = sha512_256.array(encoder.encode(methodSignature));
      return new Uint8Array(hash.slice(0, 4));
    }

    async function signAndSubmit(txns, network) {
      // txns can be single txn or array for atomic group
      const txnArray = Array.isArray(txns) ? txns : [txns];

      // Format for Pera: [[{txn}, {txn}, ...]]
      const signerTxns = txnArray.map(txn => ({ txn }));

      log("Requesting signature from Pera Wallet...", "warn");
      const signedTxns = await peraWallet.signTransaction([signerTxns]);

      if (!signedTxns || signedTxns.length === 0) {
        throw new Error("No signed transactions returned");
      }

      log("Transaction(s) signed!", "success");

      // Submit each signed transaction
      log("Submitting to network...");
      const algodClient = getAlgodClient(network);

      // For atomic groups, concatenate all signed txns
      let signedBlob;
      if (txnArray.length > 1) {
        // Concatenate for atomic group
        const totalLen = signedTxns.reduce((sum, t) => sum + t.length, 0);
        signedBlob = new Uint8Array(totalLen);
        let offset = 0;
        for (const t of signedTxns) {
          signedBlob.set(t, offset);
          offset += t.length;
        }
      } else {
        signedBlob = signedTxns[0];
      }

      const signedTxnBase64 = btoa(String.fromCharCode(...signedBlob));

      const submitRes = await fetch("/api/submit-signed", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ network, signedTxn: signedTxnBase64 }),
      });

      if (!submitRes.ok) {
        const err = await submitRes.json();
        throw new Error(err.message || "Submission failed");
      }

      return await submitRes.json();
    }

    // ==========================================================================
    // Config & ABI
    // ==========================================================================

    async function fetchConfig() {
      try {
        const response = await fetch("/api/config");
        if (!response.ok) throw new Error("Failed to fetch config");
        config = await response.json();
        expectedAddressEl.textContent = config.expectedDeployer;
        log("Configuration loaded");
      } catch (err) {
        showError(`Failed to load config: ${err.message}`);
      }
    }

    async function fetchAbi() {
      try {
        const response = await fetch("/api/abi");
        if (!response.ok) throw new Error("Failed to fetch ABI");
        abiSpec = await response.json();
        log("ABI specification loaded");
      } catch (err) {
        log(`Warning: Could not load ABI: ${err.message}`, "warn");
      }
    }

    // ==========================================================================
    // Operation UI
    // ==========================================================================

    function updateOperationUI() {
      const operation = operationSelectEl.value;

      // Update info text
      operationInfoEl.textContent = OPERATION_INFO[operation] || "";

      // Hide all field groups
      document.querySelectorAll("#form-fields > div").forEach(el => {
        el.classList.add("hidden");
      });

      // Show relevant field group
      const fieldsEl = document.getElementById(`fields-${operation}`);
      if (fieldsEl) {
        fieldsEl.classList.remove("hidden");
      }
    }

    // ==========================================================================
    // Wallet Connection
    // ==========================================================================

    function updateConnectionUI(connected, address = null) {
      if (connected && address) {
        statusDotEl.classList.add("connected");
        statusTextEl.textContent = "Connected";
        connectedAddressEl.textContent = address;
        connectedAddressEl.classList.remove("hidden");
        connectBtn.classList.add("hidden");
        disconnectBtn.classList.remove("hidden");
        operationsSectionEl.classList.remove("hidden");
      } else {
        statusDotEl.classList.remove("connected");
        statusTextEl.textContent = "Not connected";
        connectedAddressEl.classList.add("hidden");
        connectBtn.classList.remove("hidden");
        disconnectBtn.classList.add("hidden");
        operationsSectionEl.classList.add("hidden");
      }
    }

    async function connectWallet() {
      hideError();
      log("Connecting to Pera Wallet...");
      connectBtn.disabled = true;

      try {
        const network = getSelectedNetwork();
        if (peraWallet) {
          try { await peraWallet.disconnect(); } catch(e) {}
        }
        peraWallet = new PeraWalletConnect(NETWORK_CONFIG[network]);
        log(`Using network: ${network}`);

        const accounts = await peraWallet.connect();

        if (!accounts || accounts.length === 0) {
          throw new Error("No accounts returned from wallet");
        }

        const address = accounts[0];
        log(`Wallet connected: ${address.substring(0, 8)}...`);

        // Verify address matches expected admin
        if (address !== config.expectedDeployer) {
          await peraWallet.disconnect();
          throw new Error(`Wrong wallet! Expected ${config.expectedDeployer.substring(0, 8)}... but got ${address.substring(0, 8)}...`);
        }

        connectedAddress = address;
        updateConnectionUI(true, address);
        log("Address verified - ready for operations", "success");

        peraWallet.connector?.on("disconnect", () => {
          log("Wallet disconnected");
          connectedAddress = null;
          updateConnectionUI(false);
        });

      } catch (err) {
        showError(err.message);
        updateConnectionUI(false);
      } finally {
        connectBtn.disabled = false;
      }
    }

    async function disconnectWallet() {
      if (peraWallet) {
        await peraWallet.disconnect();
      }
      connectedAddress = null;
      updateConnectionUI(false);
      log("Disconnected from wallet");
    }

    // ==========================================================================
    // Transaction Builders
    // ==========================================================================

    async function executeDeploy(network) {
      const fryAsaId = document.getElementById("fry-asa-id").value;
      if (!fryAsaId) throw new Error("FRY ASA ID is required");

      log("Compiling TEAL programs...");
      const compileRes = await fetch("/api/compile-teal", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ network }),
      });

      if (!compileRes.ok) {
        const err = await compileRes.json();
        throw new Error(err.message || "Compilation failed");
      }

      const { approvalProgram, clearProgram, approvalSize, clearSize } = await compileRes.json();
      log(`Compiled: approval=${approvalSize} bytes, clear=${clearSize} bytes`);

      const approvalBytes = Uint8Array.from(atob(approvalProgram), c => c.charCodeAt(0));
      const clearBytes = Uint8Array.from(atob(clearProgram), c => c.charCodeAt(0));

      log("Building deploy transaction...");
      const algodClient = getAlgodClient(network);
      const suggestedParams = await algodClient.getTransactionParams().do();

      // Method selector for create(uint64)void
      const methodSelector = getMethodSelector("create(uint64)void");
      const fryAsaIdBytes = encodeUint64(fryAsaId);

      const txn = algosdk.makeApplicationCreateTxnFromObject({
        sender: connectedAddress,
        suggestedParams,
        approvalProgram: approvalBytes,
        clearProgram: clearBytes,
        numGlobalInts: config.stateSchema.numGlobalInts,
        numGlobalByteSlices: config.stateSchema.numGlobalByteSlices,
        numLocalInts: config.stateSchema.numLocalInts,
        numLocalByteSlices: config.stateSchema.numLocalByteSlices,
        appArgs: [methodSelector, fryAsaIdBytes],
        onComplete: algosdk.OnApplicationComplete.NoOpOC,
      });

      const result = await signAndSubmit(txn, network);
      return { title: "Deployment Successful!", value: `App ID: ${result.appId}`, ...result };
    }

    async function executeCreateFryAsa(network) {
      if (network !== "testnet") {
        throw new Error("Create FRY ASA is only allowed on testnet");
      }

      log("Building ASA create transaction...");
      const algodClient = getAlgodClient(network);
      const suggestedParams = await algodClient.getTransactionParams().do();

      const txn = algosdk.makeAssetCreateTxnWithSuggestedParamsFromObject({
        sender: connectedAddress,
        suggestedParams,
        total: BigInt("10000000000000"), // 10M with 6 decimals
        decimals: 6,
        defaultFrozen: false,
        unitName: "FRY",
        assetName: "Fry Token (Testnet)",
        manager: connectedAddress,
        reserve: connectedAddress,
        freeze: connectedAddress,
        clawback: connectedAddress,
      });

      const result = await signAndSubmit(txn, network);

      // Get asset ID from confirmed transaction
      const algodClient2 = getAlgodClient(network);
      const txInfo = await algodClient2.pendingTransactionInformation(result.txId).do();
      const assetId = Number(txInfo.assetIndex || txInfo["asset-index"] || 0);

      return { title: "FRY ASA Created!", value: `ASA ID: ${assetId}`, ...result, assetId };
    }

    async function executeOptInFry(network) {
      const appId = parseInt(document.getElementById("opt-app-id").value);
      const fryAsaId = parseInt(document.getElementById("opt-fry-id").value);
      if (!appId || !fryAsaId) throw new Error("App ID and FRY ASA ID are required");

      log("Building opt-in transaction...");
      const algodClient = getAlgodClient(network);
      const suggestedParams = await algodClient.getTransactionParams().do();

      // Add extra fee for inner transaction (use BigInt literal for algosdk v3)
      suggestedParams.fee = suggestedParams.minFee * 2n;
      suggestedParams.flatFee = true;

      // Method selector for opt_in_fry()void
      const methodSelector = getMethodSelector("opt_in_fry()void");

      const txn = algosdk.makeApplicationCallTxnFromObject({
        sender: connectedAddress,
        suggestedParams,
        appIndex: appId,
        appArgs: [methodSelector],
        foreignAssets: [fryAsaId],
        onComplete: algosdk.OnApplicationComplete.NoOpOC,
      });

      const result = await signAndSubmit(txn, network);
      return { title: "Opt-In Successful!", value: `Contract opted into FRY ASA ${fryAsaId}`, ...result };
    }

    async function executeSetMinBalance(network) {
      const appId = parseInt(document.getElementById("minbal-app-id").value);
      const minBalance = document.getElementById("min-balance").value;
      if (!appId || !minBalance) throw new Error("App ID and min balance are required");

      log("Building set min balance transaction...");
      const algodClient = getAlgodClient(network);
      const suggestedParams = await algodClient.getTransactionParams().do();

      // Method selector for admin_set_min_balance(uint64)void
      const methodSelector = getMethodSelector("admin_set_min_balance(uint64)void");
      const minBalanceBytes = encodeUint64(minBalance);

      const txn = algosdk.makeApplicationCallTxnFromObject({
        sender: connectedAddress,
        suggestedParams,
        appIndex: appId,
        appArgs: [methodSelector, minBalanceBytes],
        onComplete: algosdk.OnApplicationComplete.NoOpOC,
      });

      const result = await signAndSubmit(txn, network);
      return { title: "Min Balance Set!", value: `${minBalance} microFRY (${minBalance / 1000000} FRY)`, ...result };
    }

    async function executeFundContract(network) {
      const appId = parseInt(document.getElementById("fund-app-id").value);
      const amount = parseInt(document.getElementById("fund-amount").value);
      if (!appId || !amount) throw new Error("App ID and amount are required");

      log("Building fund transaction...");
      const algodClient = getAlgodClient(network);
      const suggestedParams = await algodClient.getTransactionParams().do();

      const appAddress = algosdk.getApplicationAddress(appId);
      log(`Contract address: ${appAddress}`);

      const txn = algosdk.makePaymentTxnWithSuggestedParamsFromObject({
        sender: connectedAddress,
        suggestedParams,
        receiver: appAddress,
        amount: BigInt(amount),
      });

      const result = await signAndSubmit(txn, network);
      return { title: "Contract Funded!", value: `${amount / 1000000} ALGO sent`, ...result };
    }

    async function executeCreateVote(network) {
      const appId = parseInt(document.getElementById("vote-app-id").value);
      const voteName = document.getElementById("vote-name").value;
      const voteType = parseInt(document.getElementById("vote-type").value);
      const optionsCount = parseInt(document.getElementById("vote-options").value);
      const durationDays = parseInt(document.getElementById("vote-duration").value);
      const lockDuration = parseInt(document.getElementById("vote-lock").value);

      if (!appId || !voteName) throw new Error("App ID and vote name are required");
      if (optionsCount < 2 || optionsCount > 8) throw new Error("Options must be 2-8");

      log("Building create vote transaction...");
      const algodClient = getAlgodClient(network);
      const suggestedParams = await algodClient.getTransactionParams().do();

      const appAddress = algosdk.getApplicationAddress(appId);
      const voteId = makeVoteId(voteName);
      const endDate = Math.floor(Date.now() / 1000) + (durationDays * 86400);

      log(`Vote ID: ${Array.from(voteId).map(b => b.toString(16).padStart(2, '0')).join('')}`);
      log(`End date: ${new Date(endDate * 1000).toISOString()}`);

      // Method selector for create_vote(byte[32],uint8,uint64,uint64,uint8,uint8,pay)void
      const methodSelector = getMethodSelector("create_vote(byte[32],uint8,uint64,uint64,uint8,uint8,pay)void");

      // Build payment transaction for MBR
      const payTxn = algosdk.makePaymentTxnWithSuggestedParamsFromObject({
        sender: connectedAddress,
        suggestedParams,
        receiver: appAddress,
        amount: VOTE_BOX_MBR,
      });

      // Build app call
      const appTxn = algosdk.makeApplicationCallTxnFromObject({
        sender: connectedAddress,
        suggestedParams,
        appIndex: appId,
        appArgs: [
          methodSelector,
          voteId,                    // vote_id (32 bytes)
          new Uint8Array([optionsCount]),  // options_count
          encodeUint64(endDate),     // end_date
          encodeUint64(lockDuration), // lock_duration
          new Uint8Array([0]),       // super_majority (0 = false)
          new Uint8Array([voteType]), // vote_type
        ],
        boxes: [{ appIndex: appId, name: new Uint8Array([...VOTE_BOX_PREFIX, ...voteId]) }],
        onComplete: algosdk.OnApplicationComplete.NoOpOC,
      });

      // Group transactions
      algosdk.assignGroupID([payTxn, appTxn]);

      const result = await signAndSubmit([payTxn, appTxn], network);
      return { title: "Vote Created!", value: `Vote "${voteName}" created`, ...result };
    }

    async function executeCloseVote(network) {
      const appId = parseInt(document.getElementById("close-app-id").value);
      const voteName = document.getElementById("close-vote-name").value;
      if (!appId || !voteName) throw new Error("App ID and vote name are required");

      log("Building close vote transaction...");
      const algodClient = getAlgodClient(network);
      const suggestedParams = await algodClient.getTransactionParams().do();

      const voteId = makeVoteId(voteName);

      // Method selector for admin_close_vote(byte[32])void
      const methodSelector = getMethodSelector("admin_close_vote(byte[32])void");

      const txn = algosdk.makeApplicationCallTxnFromObject({
        sender: connectedAddress,
        suggestedParams,
        appIndex: appId,
        appArgs: [methodSelector, voteId],
        boxes: [{ appIndex: appId, name: new Uint8Array([...VOTE_BOX_PREFIX, ...voteId]) }],
        onComplete: algosdk.OnApplicationComplete.NoOpOC,
      });

      const result = await signAndSubmit(txn, network);
      return { title: "Vote Closed!", value: `Vote "${voteName}" closed`, ...result };
    }

    // ==========================================================================
    // Execute Operation
    // ==========================================================================

    async function executeOperation() {
      hideError();
      resultSectionEl.classList.add("hidden");
      executeBtn.disabled = true;

      const operation = operationSelectEl.value;
      const network = getSelectedNetwork();
      log(`Executing ${operation} on ${network}...`);

      try {
        let result;

        switch (operation) {
          case "deploy":
            result = await executeDeploy(network);
            break;
          case "create-fry-asa":
            result = await executeCreateFryAsa(network);
            break;
          case "opt-in-fry":
            result = await executeOptInFry(network);
            break;
          case "set-min-balance":
            result = await executeSetMinBalance(network);
            break;
          case "fund-contract":
            result = await executeFundContract(network);
            break;
          case "create-vote":
            result = await executeCreateVote(network);
            break;
          case "close-vote":
            result = await executeCloseVote(network);
            break;
          default:
            throw new Error(`Unknown operation: ${operation}`);
        }

        log(`SUCCESS: ${result.title}`, "success");
        resultTitleEl.textContent = result.title;
        resultValueEl.textContent = result.value;
        resultTxidEl.textContent = result.txId;
        resultRoundEl.textContent = result.confirmedRound;
        resultSectionEl.classList.remove("hidden");

      } catch (err) {
        if (err.message.includes("rejected") || err.message.includes("cancelled") || err.message.includes("closed")) {
          showError("Transaction was rejected or cancelled by user");
        } else {
          showError(err.message);
        }
      } finally {
        executeBtn.disabled = false;
      }
    }

    // ==========================================================================
    // Event Listeners
    // ==========================================================================

    connectBtn.addEventListener("click", connectWallet);
    disconnectBtn.addEventListener("click", disconnectWallet);
    executeBtn.addEventListener("click", executeOperation);
    operationSelectEl.addEventListener("change", updateOperationUI);

    // ==========================================================================
    // Initialize
    // ==========================================================================

    async function init() {
      await fetchConfig();
      await fetchAbi();
      updateOperationUI();
    }

    try {
      init().catch(err => {
        console.error("[wc-signer] Async init error:", err);
        document.body.innerHTML = `<div style="color:#e74c3c;padding:2rem;font-family:monospace;background:#1a1a2e;">
          <h2>JS Initialization Failed</h2>
          <pre>${err.stack || err.message || err}</pre>
        </div>`;
      });
    } catch (err) {
      console.error("[wc-signer] Sync init error:", err);
      document.body.innerHTML = `<div style="color:#e74c3c;padding:2rem;font-family:monospace;background:#1a1a2e;">
        <h2>JS Initialization Failed</h2>
        <pre>${err.stack || err.message || err}</pre>
      </div>`;
    }
  </script>
</body>
</html>
