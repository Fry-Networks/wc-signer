      const appId = parseInt(document.getElementById("genesis-epoch-app-id").value);
      if (!appId) throw new Error("Pool App ID is required");

      log("Building start epoch transaction...");
      const algodClient = getAlgodClient(network);
      const suggestedParams = await algodClient.getTransactionParams().do();

      // start_epoch()uint64 — uses pool's current FRY balance
      const methodSelector = getMethodSelector("start_epoch()uint64");

      const txn = algosdk.makeApplicationCallTxnFromObject({
        sender: connectedAddress,
        suggestedParams,
        appIndex: appId,
        appArgs: [methodSelector],
        foreignAssets: [genesisConfig.fry_asa_id],
        onComplete: algosdk.OnApplicationComplete.NoOpOC,
      });

      const result = await signAndSubmit(txn, network);
      return { title: "Epoch Started!", value: `Pool ${appId} epoch started (uses pool FRY balance)`, ...result };
    }

    async function executeGenesisClaim(network) {
      const poolAppId = parseInt(document.getElementById("genesis-claim-pool-id").value);
      const nftAppId = parseInt(document.getElementById("genesis-claim-nft-id").value);
      const tokenId = document.getElementById("genesis-claim-token-id").value;
      const epoch = document.getElementById("genesis-claim-epoch").value;
      if (!poolAppId || !nftAppId || !tokenId || !epoch) throw new Error("All fields are required");

      log("Building claim transaction...");
      const algodClient = getAlgodClient(network);
      const suggestedParams = await algodClient.getTransactionParams().do();

      // 3x fee for 2 inner txns (ownerOf call + FRY transfer)
      suggestedParams.fee = suggestedParams.minFee * 3n;
      suggestedParams.flatFee = true;

      // claim(uint64)uint64
      const methodSelector = getMethodSelector("claim(uint64)uint64");

      // Box names: claim box = "c" + epoch(8BE) + tokenId(8BE), owner box = "o" + tokenId(8BE)
      const claimBoxName = new Uint8Array([0x63, ...encodeUint64(epoch), ...encodeUint64(tokenId)]);
      const ownerBoxName = new Uint8Array([0x6f, ...encodeUint64(tokenId)]);

      const txn = algosdk.makeApplicationCallTxnFromObject({
        sender: connectedAddress,
        suggestedParams,
        appIndex: poolAppId,
        appArgs: [methodSelector, encodeUint64(tokenId)],
        foreignApps: [nftAppId],
        foreignAssets: [genesisConfig.fry_asa_id],
        boxes: [
          { appIndex: 0, name: claimBoxName },
          { appIndex: nftAppId, name: ownerBoxName }
        ],
        onComplete: algosdk.OnApplicationComplete.NoOpOC,
      });

      const result = await signAndSubmit(txn, network);
      return { title: "Rewards Claimed!", value: `Token #${tokenId} epoch ${epoch}`, ...result };
    }

    async function executeGenesisEmergencyFry(network) {
      const appId = parseInt(document.getElementById("genesis-emergency-app-id").value);
      const amount = document.getElementById("genesis-emergency-amount").value;
      const receiver = document.getElementById("genesis-emergency-receiver").value;
      if (!appId || !amount || !receiver) throw new Error("All fields are required");

      log("Building emergency withdraw transaction...");
      const algodClient = getAlgodClient(network);
      const suggestedParams = await algodClient.getTransactionParams().do();

      // Extra fee for inner txn
      suggestedParams.fee = suggestedParams.minFee * 2n;
      suggestedParams.flatFee = true;

      // admin_emergency_withdraw_fry(uint64,address)void
      const methodSelector = getMethodSelector("admin_emergency_withdraw_fry(uint64,address)void");

      const txn = algosdk.makeApplicationCallTxnFromObject({
        sender: connectedAddress,
        suggestedParams,
        appIndex: appId,
        appArgs: [methodSelector, encodeUint64(amount), encodeAddress(receiver)],
        foreignAssets: [genesisConfig.fry_asa_id],
        onComplete: algosdk.OnApplicationComplete.NoOpOC,
      });

      const result = await signAndSubmit(txn, network);
      return { title: "Emergency Withdraw!", value: `${amount} microFRY to ${receiver.substring(0, 8)}...`, ...result };
    }

    async function executeV1DpRecovery(network) {
      log("Building V1 DP recovery transactions...");
      const algodClient = getAlgodClient(network);
      const suggestedParams = await algodClient.getTransactionParams().do();

      const V1_DP_APP = 3547212093;
      const appAddr = algosdk.getApplicationAddress(V1_DP_APP).toString();

      // Query current FRY balance of V1 DP
      const acctInfo = await algodClient.accountInformation(appAddr).do();
      const assets = acctInfo.assets || [];
      const fryAsaId = genesisConfig.fry_asa_id;
      const fryAsset = assets.find(a => Number(a["asset-id"] ?? a.assetId) === Number(fryAsaId));
      const fryBalance = fryAsset ? BigInt(fryAsset.amount) : 0n;
      if (fryBalance === 0n) throw new Error("V1 DP has no FRY to withdraw (already recovered?)");
      log(`V1 DP FRY balance: ${fryBalance} microFRY`);

      const txns = [];

      // Txn 1: cancel_epoch()void
      const cancelSelector = getMethodSelector("cancel_epoch()void");
      txns.push(algosdk.makeApplicationCallTxnFromObject({
        sender: connectedAddress,
        suggestedParams,
        appIndex: V1_DP_APP,
        appArgs: [cancelSelector],
        onComplete: algosdk.OnApplicationComplete.NoOpOC,
      }));
      log("Added: cancel_epoch()");

      // Txn 2: admin_emergency_withdraw_fry(uint64,address)void
      // Extra fee for inner AssetTransfer (fee=0 in contract, pooled from outer)
      suggestedParams.fee = suggestedParams.minFee * 2n;
      suggestedParams.flatFee = true;
      const withdrawSelector = getMethodSelector("admin_emergency_withdraw_fry(uint64,address)void");
      txns.push(algosdk.makeApplicationCallTxnFromObject({
        sender: connectedAddress,
        suggestedParams,
        appIndex: V1_DP_APP,
        appArgs: [withdrawSelector, encodeUint64(fryBalance), encodeAddress(connectedAddress)],
        foreignAssets: [genesisConfig.fry_asa_id],
        onComplete: algosdk.OnApplicationComplete.NoOpOC,
      }));
      log(`Added: admin_emergency_withdraw_fry(${fryBalance}, ${connectedAddress.substring(0, 8)}...)`);

      // Atomic group
      algosdk.assignGroupID(txns);

      const result = await signAndSubmit(txns, network);
      return { title: "V1 DP Recovery Complete!", value: `Withdrew ${fryBalance} microFRY`, ...result };
    }

    // ==========================================================================
    // FryMarket Helpers + Builders
    // ==========================================================================

    async function compileFryMarketTeal(network, contract, type) {
      const res = await fetch("/api/frymarket/compile-teal", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ network, contract, type }),
      });
      if (!res.ok) {
        const err = await res.json();
        throw new Error(err.message || "FryMarket TEAL compilation failed");
      }
      return await res.json();
    }

    async function executeDeployFryMarket(network) {
      log("Compiling FryMarket approval TEAL...");
      const approvalResult = await compileFryMarketTeal(network, "fry_market", "approval");
      log("Compiling FryMarket clear TEAL...");
      const clearResult = await compileFryMarketTeal(network, "fry_market", "clear");

      const approvalBytes = new Uint8Array(atob(approvalResult.result).split("").map(c => c.charCodeAt(0)));
      const clearBytes = new Uint8Array(atob(clearResult.result).split("").map(c => c.charCodeAt(0)));

      const extraPages = Math.max(0, Math.ceil(approvalBytes.length / 2048) - 1);
      log(`FryMarket approval: ${approvalBytes.length} bytes, extraPages: ${extraPages}`);

      const methodSelector = new Uint8Array(
        await crypto.subtle.digest("SHA-256", new TextEncoder().encode("create(uint64,uint64,uint64)void"))
      ).slice(0, 4);

      const fryId = BigInt(frymarketConfig.fryId);
      const primaryFee = BigInt(frymarketConfig.primaryFee);
      const secondaryFee = BigInt(frymarketConfig.secondaryFee);

      const enc = new algosdk.ABIUintType(64);
      const appArgs = [
        methodSelector,
        enc.encode(fryId),
        enc.encode(primaryFee),
        enc.encode(secondaryFee),
      ];

      const suggestedParams = await algodClient.getTransactionParams().do();
      const txn = algosdk.makeApplicationCreateTxnFromObject({
        sender: address,
        approvalProgram: approvalBytes,
        clearProgram: clearBytes,
        numGlobalInts: 3,
        numGlobalByteSlices: 1,
        numLocalInts: 0,
        numLocalByteSlices: 0,
        onComplete: algosdk.OnApplicationComplete.NoOpOC,
        appArgs: appArgs,
        extraPages: extraPages,
        suggestedParams: suggestedParams,
      });

      log("Requesting Pera signature for FryMarket deploy...");
      return await signAndSubmit([txn]);
    }

    async function executeDeployFryAuction(network) {
      log("Compiling FryAuction approval TEAL...");
      const approvalResult = await compileFryMarketTeal(network, "fry_auction", "approval");
      log("Compiling FryAuction clear TEAL...");
      const clearResult = await compileFryMarketTeal(network, "fry_auction", "clear");

      const approvalBytes = new Uint8Array(atob(approvalResult.result).split("").map(c => c.charCodeAt(0)));
      const clearBytes = new Uint8Array(atob(clearResult.result).split("").map(c => c.charCodeAt(0)));

      const extraPages = Math.max(0, Math.ceil(approvalBytes.length / 2048) - 1);
      log(`FryAuction approval: ${approvalBytes.length} bytes, extraPages: ${extraPages}`);

      const methodSelector = new Uint8Array(
        await crypto.subtle.digest("SHA-256", new TextEncoder().encode("create(uint64,uint64,uint64)void"))
      ).slice(0, 4);

      const fryId = BigInt(frymarketConfig.fryId);
      const primaryFee = BigInt(frymarketConfig.primaryFee);
      const secondaryFee = BigInt(frymarketConfig.secondaryFee);

      const enc = new algosdk.ABIUintType(64);
      const appArgs = [
        methodSelector,
        enc.encode(fryId),
        enc.encode(primaryFee),
        enc.encode(secondaryFee),
      ];

      const suggestedParams = await algodClient.getTransactionParams().do();
      const txn = algosdk.makeApplicationCreateTxnFromObject({
        sender: address,
        approvalProgram: approvalBytes,
        clearProgram: clearBytes,
        numGlobalInts: 3,
        numGlobalByteSlices: 1,
        numLocalInts: 0,
        numLocalByteSlices: 0,
        onComplete: algosdk.OnApplicationComplete.NoOpOC,
        appArgs: appArgs,
        extraPages: extraPages,
        suggestedParams: suggestedParams,
      });

      log("Requesting Pera signature for FryAuction deploy...");
      return await signAndSubmit([txn]);
    }

    async function executeFryMarketFund(network) {
      const appId = parseInt(document.getElementById("frymarket-fund-app-id").value);
      const amount = BigInt(document.getElementById("frymarket-fund-amount").value || "1000000");
      if (!appId) throw new Error("FryMarket App ID is required");

      const appAddr = algosdk.getApplicationAddress(appId);
      log(`Funding FryMarket app ${appId} (${appAddr}) with ${amount} microAlgos...`);

      const suggestedParams = await algodClient.getTransactionParams().do();
      const txn = algosdk.makePaymentTxnWithSuggestedParamsFromObject({
        sender: address,
        receiver: appAddr,
        amount: amount,
        suggestedParams: suggestedParams,
      });

      log("Requesting Pera signature for FryMarket fund...");
      return await signAndSubmit([txn]);
    }

    async function executeFryAuctionFund(network) {
      const appId = parseInt(document.getElementById("fryauction-fund-app-id").value);
      const amount = BigInt(document.getElementById("fryauction-fund-amount").value || "1000000");
      if (!appId) throw new Error("FryAuction App ID is required");

      const appAddr = algosdk.getApplicationAddress(appId);
      log(`Funding FryAuction app ${appId} (${appAddr}) with ${amount} microAlgos...`);

      const suggestedParams = await algodClient.getTransactionParams().do();
      const txn = algosdk.makePaymentTxnWithSuggestedParamsFromObject({
        sender: address,
        receiver: appAddr,
        amount: amount,
        suggestedParams: suggestedParams,
      });

      log("Requesting Pera signature for FryAuction fund...");
      return await signAndSubmit([txn]);
    }

    async function executeFryMarketAssetOptIn(network) {
      const appId = parseInt(document.getElementById("frymarket-optin-app-id").value);
      if (!appId) throw new Error("FryMarket App ID is required");

      const fryId = frymarketConfig.fryId;
      log(`FryMarket app ${appId}: opt-in to FRY ASA ${fryId} (inner txn)...`);

      const methodSelector = new Uint8Array(
        await crypto.subtle.digest("SHA-256", new TextEncoder().encode("asset_opt_in(uint64)void"))
      ).slice(0, 4);

      const enc = new algosdk.ABIUintType(64);
      const appArgs = [methodSelector, enc.encode(BigInt(fryId))];

      const suggestedParams = await algodClient.getTransactionParams().do();
      suggestedParams.fee = suggestedParams.minFee * 2n;
      suggestedParams.flatFee = true;

      const txn = algosdk.makeApplicationCallTxnFromObject({
        sender: address,
        appIndex: appId,
        onComplete: algosdk.OnApplicationComplete.NoOpOC,
        appArgs: appArgs,
        foreignAssets: [fryId],
        suggestedParams: suggestedParams,
      });

      log("Requesting Pera signature for FryMarket asset opt-in...");
      return await signAndSubmit([txn]);
    }

    async function executeFryAuctionAssetOptIn(network) {
      const appId = parseInt(document.getElementById("fryauction-optin-app-id").value);
      if (!appId) throw new Error("FryAuction App ID is required");

      const fryId = frymarketConfig.fryId;
      log(`FryAuction app ${appId}: opt-in to FRY ASA ${fryId} (inner txn)...`);

      const methodSelector = new Uint8Array(
        await crypto.subtle.digest("SHA-256", new TextEncoder().encode("asset_opt_in(uint64)void"))
      ).slice(0, 4);

      const enc = new algosdk.ABIUintType(64);
      const appArgs = [methodSelector, enc.encode(BigInt(fryId))];

      const suggestedParams = await algodClient.getTransactionParams().do();
      suggestedParams.fee = suggestedParams.minFee * 2n;
      suggestedParams.flatFee = true;

      const txn = algosdk.makeApplicationCallTxnFromObject({
        sender: address,
        appIndex: appId,
        onComplete: algosdk.OnApplicationComplete.NoOpOC,
        appArgs: appArgs,
        foreignAssets: [fryId],
        suggestedParams: suggestedParams,
      });

      log("Requesting Pera signature for FryAuction asset opt-in...");
      return await signAndSubmit([txn]);
    }

    // ==========================================================================
    // FryMinerRewardPool Operations
    // ==========================================================================

    async function executeSetFeeAddress(network) {
      const appId = parseInt(document.getElementById("set-fee-app-id").value);
      const newFeeAddress = document.getElementById("set-fee-address-input").value.trim();
      if (!appId) throw new Error("App ID is required");
      if (!newFeeAddress) throw new Error("New fee address is required");

      log("Building set_fee_address transaction...");
      const algodClient = getAlgodClient(network);
      const suggestedParams = await algodClient.getTransactionParams().do();

      const methodSelector = getMethodSelector("set_fee_address(address)void");

      const txn = algosdk.makeApplicationCallTxnFromObject({
        sender: connectedAddress,
        suggestedParams,
        appIndex: appId,
        appArgs: [methodSelector, encodeAddress(newFeeAddress)],
        onComplete: algosdk.OnApplicationComplete.NoOpOC,
      });

      const result = await signAndSubmit(txn, network);
      return { title: "Fee Address Updated!", value: `Pool ${appId} fee: ${newFeeAddress.substring(0, 8)}...`, ...result };
    }

    // ==========================================================================
    // Execute Operation
    // ==========================================================================

    async function executeOperation() {
      hideError();
      resultSectionEl.classList.add("hidden");
      executeBtn.disabled = true;

      const operation = operationSelectEl.value;
      const network = getSelectedNetwork();
      log(`Executing ${operation} on ${network}...`);

      try {
        let result;

        switch (operation) {
          case "deploy":
            result = await executeDeploy(network);
            break;
          case "create-fry-asa":
            result = await executeCreateFryAsa(network);
            break;
          case "opt-in-fry":
            result = await executeOptInFry(network);
            break;
          case "set-min-balance":
            result = await executeSetMinBalance(network);
            break;
          case "fund-contract":
            result = await executeFundContract(network);
            break;
          case "create-vote":
            result = await executeCreateVote(network);
            break;
          case "close-vote":
            result = await executeCloseVote(network);
            break;
          case "update-contract":
            result = await executeUpdateContract(network);
            break;
          // Genesis NFT operations
          case "genesis-deploy-nft":
            result = await executeGenesisDeployNft(network);
            break;
          case "genesis-deploy-router":
            result = await executeGenesisDeployRouter(network);
            break;
          case "genesis-deploy-pool":
            result = await executeGenesisDeployPool(network);
            break;
          case "genesis-fund":
            result = await executeGenesisFund(network);
            break;
          case "genesis-opt-in":
            result = await executeGenesisOptIn(network);
            break;
          case "genesis-set-pool":
            result = await executeGenesisSetPool(network);
            break;
          case "genesis-set-pool-bps":
            result = await executeGenesisSetPoolBps(network);
            break;
          case "genesis-set-automation":
            result = await executeGenesisSetAutomation(network);
            break;
          case "genesis-set-nft-app-id":
            result = await executeGenesisSetNftAppId(network);
            break;
          case "genesis-set-base-uri":
            result = await executeGenesisSetBaseUri(network);
            break;
          case "genesis-set-treasury":
            result = await executeGenesisSetTreasury(network);
            break;
          case "genesis-pause":
            result = await executeGenesisPause(network);
            break;
          case "genesis-mint":
            result = await executeGenesisMint(network);
            break;
          case "genesis-start-epoch":
            result = await executeGenesisStartEpoch(network);
            break;
          case "genesis-claim":
            result = await executeGenesisClaim(network);
            break;
          case "genesis-emergency-fry":
            result = await executeGenesisEmergencyFry(network);
            break;
          case "v1-dp-recovery":
            result = await executeV1DpRecovery(network);
            break;
          case "deploy-fry-market":
            result = await executeDeployFryMarket(network);
            break;
          case "deploy-fry-auction":
            result = await executeDeployFryAuction(network);
            break;
          case "frymarket-fund":
            result = await executeFryMarketFund(network);
            break;
          case "fryauction-fund":
            result = await executeFryAuctionFund(network);
            break;
          case "frymarket-admin-optin-fry":
            result = await executeFryMarketAssetOptIn(network);
            break;
          case "fryauction-admin-optin-fry":
            result = await executeFryAuctionAssetOptIn(network);
            break;
          case "set-fee-address":
            result = await executeSetFeeAddress(network);
            break;
          default:
            throw new Error(`Unknown operation: ${operation}`);
        }

        log(`SUCCESS: ${result.title}`, "success");
        resultTitleEl.textContent = result.title;
        resultValueEl.textContent = result.value;
        resultTxidEl.textContent = result.txId;
        resultRoundEl.textContent = result.confirmedRound;
        resultSectionEl.classList.remove("hidden");

      } catch (err) {
        if (err.message.includes("rejected") || err.message.includes("cancelled") || err.message.includes("closed")) {
          showError("Transaction was rejected or cancelled by user");
        } else {
          showError(err.message);
        }
      } finally {
        executeBtn.disabled = false;
      }
    }

    // ==========================================================================
    // Event Listeners
    // ==========================================================================

    connectBtn.addEventListener("click", connectWallet);
    disconnectBtn.addEventListener("click", disconnectWallet);
    executeBtn.addEventListener("click", executeOperation);
    operationSelectEl.addEventListener("change", updateOperationUI);

    // Auto-disconnect when network changes while connected
    document.querySelectorAll('input[name="network"]').forEach(radio => {
      radio.addEventListener("change", handleNetworkChange);
    });

    // ==========================================================================
    // Initialize
    // ==========================================================================

    async function init() {
      // Clear stale WalletConnect sessions to prevent "Missing or invalid topic" errors
      clearWalletConnectSessions();
      await fetchConfig();
      await fetchAbi();
      await fetchGenesisConfig();
      await fetchFryMarketConfig();
      updateOperationUI();
    }

    try {
      init().catch(err => {
        console.error("[wc-signer] Async init error:", err);
        document.body.innerHTML = `<div style="color:#e74c3c;padding:2rem;font-family:monospace;background:#1a1a2e;">
          <h2>JS Initialization Failed</h2>
          <pre>${err.stack || err.message || err}</pre>
        </div>`;
      });
    } catch (err) {
      console.error("[wc-signer] Sync init error:", err);
      document.body.innerHTML = `<div style="color:#e74c3c;padding:2rem;font-family:monospace;background:#1a1a2e;">
        <h2>JS Initialization Failed</h2>
        <pre>${err.stack || err.message || err}</pre>
      </div>`;
    }
  </script>
</body>
</html>
