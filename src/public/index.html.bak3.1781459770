    // ==========================================================================
    // FryMinerRewardPool Operations
    // ==========================================================================

    async function executeSetFeeAddress(network) {
      const appId = parseInt(document.getElementById("set-fee-app-id").value);
      const newFeeAddress = document.getElementById("set-fee-address-input").value.trim();
      if (!appId) throw new Error("App ID is required");
      if (!newFeeAddress) throw new Error("New fee address is required");

      log("Building set_fee_address transaction...");
      const algodClient = getAlgodClient(network);
      const suggestedParams = await algodClient.getTransactionParams().do();

      const methodSelector = getMethodSelector("set_fee_address(address)void");

      const txn = algosdk.makeApplicationCallTxnFromObject({
        sender: connectedAddress,
        suggestedParams,
        appIndex: appId,
        appArgs: [methodSelector, encodeAddress(newFeeAddress)],
        onComplete: algosdk.OnApplicationComplete.NoOpOC,
      });

      const result = await signAndSubmit(txn, network);
      return { title: "Fee Address Updated!", value: `Pool ${appId} fee: ${newFeeAddress.substring(0, 8)}...`, ...result };
    }

    // ==========================================================================
    // Execute Operation
    // ==========================================================================

    async function executeOperation() {
      hideError();
      resultSectionEl.classList.add("hidden");
      executeBtn.disabled = true;

      const operation = operationSelectEl.value;
      const network = getSelectedNetwork();
      log(`Executing ${operation} on ${network}...`);

      try {
        let result;

        switch (operation) {
          case "deploy":
            result = await executeDeploy(network);
            break;
          case "create-fry-asa":
            result = await executeCreateFryAsa(network);
            break;
          case "opt-in-fry":
            result = await executeOptInFry(network);
            break;
          case "set-min-balance":
            result = await executeSetMinBalance(network);
            break;
          case "fund-contract":
            result = await executeFundContract(network);
            break;
          case "create-vote":
            result = await executeCreateVote(network);
            break;
          case "close-vote":
            result = await executeCloseVote(network);
            break;
          case "update-contract":
            result = await executeUpdateContract(network);
            break;
          // Genesis NFT operations
          case "genesis-deploy-nft":
            result = await executeGenesisDeployNft(network);
            break;
          case "genesis-deploy-router":
            result = await executeGenesisDeployRouter(network);
            break;
          case "genesis-deploy-pool":
            result = await executeGenesisDeployPool(network);
            break;
          case "genesis-fund":
            result = await executeGenesisFund(network);
            break;
          case "genesis-opt-in":
            result = await executeGenesisOptIn(network);
            break;
          case "genesis-set-pool":
            result = await executeGenesisSetPool(network);
            break;
          case "genesis-set-pool-bps":
            result = await executeGenesisSetPoolBps(network);
            break;
          case "genesis-set-automation":
            result = await executeGenesisSetAutomation(network);
            break;
          case "genesis-set-nft-app-id":
            result = await executeGenesisSetNftAppId(network);
            break;
          case "genesis-set-base-uri":
            result = await executeGenesisSetBaseUri(network);
            break;
          case "genesis-set-treasury":
            result = await executeGenesisSetTreasury(network);
            break;
          case "genesis-pause":
            result = await executeGenesisPause(network);
            break;
          case "genesis-mint":
            result = await executeGenesisMint(network);
            break;
          case "genesis-start-epoch":
            result = await executeGenesisStartEpoch(network);
            break;
          case "genesis-claim":
            result = await executeGenesisClaim(network);
            break;
          case "genesis-emergency-fry":
            result = await executeGenesisEmergencyFry(network);
            break;
          case "v1-dp-recovery":
            result = await executeV1DpRecovery(network);
            break;
          case "deploy-fry-market":
            result = await executeDeployFryMarket(network);
            break;
          case "deploy-fry-auction":
            result = await executeDeployFryAuction(network);
            break;
          case "frymarket-fund":
            result = await executeFryMarketFund(network);
            break;
          case "fryauction-fund":
            result = await executeFryAuctionFund(network);
            break;
          case "frymarket-admin-optin-fry":
            result = await executeFryMarketAssetOptIn(network);
            break;
          case "fryauction-admin-optin-fry":
            result = await executeFryAuctionAssetOptIn(network);
            break;
          case "set-fee-address":
            result = await executeSetFeeAddress(network);
            break;
          default:
            throw new Error(`Unknown operation: ${operation}`);
        }

        log(`SUCCESS: ${result.title}`, "success");
        resultTitleEl.textContent = result.title;
        resultValueEl.textContent = result.value;
        resultTxidEl.textContent = result.txId;
        resultRoundEl.textContent = result.confirmedRound;
        resultSectionEl.classList.remove("hidden");

      } catch (err) {
        if (err.message.includes("rejected") || err.message.includes("cancelled") || err.message.includes("closed")) {
          showError("Transaction was rejected or cancelled by user");
        } else {
          showError(err.message);
        }
      } finally {
        executeBtn.disabled = false;
      }
    }

    // ==========================================================================
    // Event Listeners
    // ==========================================================================

    connectBtn.addEventListener("click", connectWallet);
    disconnectBtn.addEventListener("click", disconnectWallet);
    executeBtn.addEventListener("click", executeOperation);
    operationSelectEl.addEventListener("change", updateOperationUI);

    // Auto-disconnect when network changes while connected
    document.querySelectorAll('input[name="network"]').forEach(radio => {
      radio.addEventListener("change", handleNetworkChange);
    });

    // ==========================================================================
    // Initialize
    // ==========================================================================

    async function init() {
      // Clear stale WalletConnect sessions to prevent "Missing or invalid topic" errors
      clearWalletConnectSessions();
      await fetchConfig();
      await fetchAbi();
      await fetchGenesisConfig();
      await fetchFryMarketConfig();
      updateOperationUI();
      await batchInit();
    }

    // ======================================================================
    // Working QR Renderer (standalone qrcodejs — replaces broken bundle.js QR)
    // ======================================================================

    function renderWorkingQR(uri) {
      var el = document.getElementById('working-qr');
      while (el.firstChild) el.removeChild(el.firstChild);
      el.style.display = 'block';
      el.dataset.uri = uri;
      if (typeof QRCode !== 'undefined') {
        new QRCode(el, { text: uri, width: 280, height: 280, correctLevel: QRCode.CorrectLevel.M });
        log("QR code rendered — scan with Pera", "success");
      } else {
        el.textContent = 'QR library failed to load';
        log("QR library (qrcode.min.js) not loaded — CDN may be unreachable", "error");
      }
    }

    // ======================================================================
    // BATCH PLAN EXECUTION (ported from call-batch.html)
    // Activated only when ?src= URL parameter is present.
    // All functions prefixed "batch" to avoid collisions with existing code.
    // ======================================================================

    var batchMode = false;
    var batchPlan = null;
    var batchAbiMethods = null;
    var batchVerificationPassed = false;
    var batchHashVerified = false;

    // --- Batch Utilities ---

    function batchHexToBytes(hex) {
      if (hex.startsWith("hex:")) hex = hex.slice(4);
      hex = hex.replace(/^0x/, "");
      if (hex.length % 2 !== 0) throw new Error("Invalid hex length");
      var bytes = new Uint8Array(hex.length / 2);
      for (var i = 0; i < hex.length; i += 2) bytes[i / 2] = parseInt(hex.substr(i, 2), 16);
      return bytes;
    }

    async function batchSha256Bytes(data) {
      return new Uint8Array(await crypto.subtle.digest("SHA-256", data));
    }

    async function batchComputePlanHash(rawText) {
      var buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(rawText));
      return Array.from(new Uint8Array(buf)).map(function(b) { return b.toString(16).padStart(2, "0"); }).join("");
    }

    // --- Batch ABI Encoding ---

    function batchEncodeAbiArg(value, type, groupTxns, txnIndex) {
      if (type === "uint8") return new Uint8Array([Number(value) & 0xff]);
      if (type === "uint16") { var v = Number(value); return new Uint8Array([(v >> 8) & 0xff, v & 0xff]); }
      if (type === "uint32") { var v2 = Number(value); return new Uint8Array([(v2 >> 24) & 0xff, (v2 >> 16) & 0xff, (v2 >> 8) & 0xff, v2 & 0xff]); }
      if (type === "uint64") return encodeUint64(value);
      if (type.startsWith("byte[") || type === "byte") {
        if (typeof value === "string" && value.startsWith("hex:")) return batchHexToBytes(value);
        if (typeof value === "string") {
          try { var bin = atob(value); var bytes = new Uint8Array(bin.length); for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i); return bytes; }
          catch (e) { return new TextEncoder().encode(value); }
        }
        if (value instanceof Uint8Array) return value;
        throw new Error("Unsupported bytes value");
      }
      if (type === "address") {
        var addr = (typeof value === "string" && value.startsWith("addr:")) ? value.slice(5) : value;
        return algosdk.decodeAddress(addr).publicKey;
      }
      if (["pay", "axfer", "appl", "acfg", "afrz"].indexOf(type) >= 0) {
        for (var k = 0; k < groupTxns.length; k++) {
          if (k < txnIndex && groupTxns[k].type === type) return new Uint8Array([k]);
        }
        throw new Error("No " + type + " txn found before index " + txnIndex);
      }
      if (type === "bool") return new Uint8Array([value ? 1 : 0]);
      throw new Error("Unsupported ABI type: " + type);
    }

    // --- Batch Transaction Building ---

    function batchBuildAppArgs(methodName, planArgs, groupTxns, txnIndex, abiMethod) {
      var argTypes = (abiMethod.args || []).map(function(a) { return a.type; }).join(",");
      var retType = (abiMethod.returns && abiMethod.returns.type !== "void") ? abiMethod.returns.type : "void";
      var sig = abiMethod.name + "(" + argTypes + ")" + retType;
      var selectorBytes = getMethodSelector(sig);
      var match = sig.match(/\((.*)\)/);
      if (!match) throw new Error("Bad method signature: " + sig);
      var typeList = match[1].split(",").filter(function(t) { return t.trim(); });
      var encodedArgs = [];
      var argIdx = 0;
      for (var i = 0; i < typeList.length; i++) {
        var t = typeList[i].trim();
        if (["pay", "axfer", "appl", "acfg", "afrz"].indexOf(t) >= 0) {
          encodedArgs.push(batchEncodeAbiArg(null, t, groupTxns, txnIndex));
        } else {
          if (argIdx >= (planArgs || []).length) throw new Error("Missing arg " + argIdx + " for " + sig);
          encodedArgs.push(batchEncodeAbiArg(planArgs[argIdx], t, groupTxns, txnIndex));
          argIdx++;
        }
      }
      return [selectorBytes].concat(encodedArgs);
    }

    function batchBuildNonApplTxn(planTxn, sp, senderAddr) {
      if (planTxn.type === "pay") {
        return algosdk.makePaymentTxnWithSuggestedParamsFromObject({
          sender: senderAddr, receiver: planTxn.to, amount: BigInt(planTxn.amount),
          note: planTxn.note ? new TextEncoder().encode(planTxn.note) : undefined, suggestedParams: sp
        });
      }
      if (planTxn.type === "axfer") {
        return algosdk.makeAssetTransferTxnWithSuggestedParamsFromObject({
          sender: senderAddr, receiver: planTxn.to, assetIndex: Number(planTxn.assetId),
          amount: BigInt(planTxn.amount), suggestedParams: sp
        });
      }
      throw new Error("Unknown txn type: " + planTxn.type);
    }

    function batchBuildGroup(group, sp, appId, senderAddr) {
      var raw = group.txns.map(function(pt, i) {
        if (pt.type === "appl") {
          var abiMethod = batchAbiMethods.get(pt.method);
          if (!abiMethod) throw new Error("Unknown method: " + pt.method);
          return { __isAppl: true, planTxn: pt, abiMethod: abiMethod, sender: senderAddr, appId: appId, sp: sp, index: i };
        }
        return batchBuildNonApplTxn(pt, sp, senderAddr);
      });
      var txns = raw.map(function(item, i) {
        if (item.__isAppl) {
          var appArgs = batchBuildAppArgs(item.planTxn.method, item.planTxn.args, group.txns, i, item.abiMethod);
          var boxes = (item.planTxn.boxes || []).map(function(b) {
            var name;
            if (typeof b === "string" && b.startsWith("hex:")) name = batchHexToBytes(b);
            else if (typeof b === "string") name = new TextEncoder().encode(b);
            else if (b && typeof b.name === "string" && b.name.startsWith("hex:")) name = batchHexToBytes(b.name);
            else if (b && b.name instanceof Uint8Array) name = b.name;
            else if (b && typeof b.name === "string") name = new TextEncoder().encode(b.name);
            else throw new Error("Bad box name");
            var appIndex = (b && b.appIndex != null) ? Number(b.appIndex) : Number(appId);
            return { appIndex: appIndex, name: name };
          });
          return algosdk.makeApplicationNoOpTxnFromObject({
            sender: item.sender, appIndex: Number(item.appId), appArgs: appArgs,
            suggestedParams: item.sp, boxes: boxes
          });
        }
        return item;
      });
      algosdk.assignGroupID(txns);
      return txns;
    }

    // --- Batch Verification Gates ---

    function batchVerifyAddresses(p) {
      var allAddrs = new Set();
      allAddrs.add(p.sender);
      for (var gi = 0; gi < p.groups.length; gi++) {
        var g = p.groups[gi];
        for (var ti = 0; ti < g.txns.length; ti++) {
          var t = g.txns[ti];
          if (t.to) allAddrs.add(t.to);
          for (var ai = 0; ai < (t.args || []).length; ai++) {
            var a = t.args[ai];
            if (typeof a === "string" && a.length === 58 && !a.startsWith("hex:")) allAddrs.add(a);
          }
        }
      }
      var failures = [];
      allAddrs.forEach(function(addr) { try { algosdk.decodeAddress(addr); } catch (e) { failures.push(addr); } });
      return { label: "Address decode check", passed: failures.length === 0, detail: failures.length ? "Failed: " + failures.join(", ") : "All " + allAddrs.size + " addresses valid" };
    }

    function batchVerifyFryAmounts(p) {
      var importSum = 0, axferAmount = null;
      for (var gi = 0; gi < p.groups.length; gi++) {
        var g = p.groups[gi];
        for (var ti = 0; ti < g.txns.length; ti++) {
          var t = g.txns[ti];
          if (t.type === "appl" && t.method === "admin_import_stake") importSum += Number(t.args[3] || 0);
          if (t.type === "axfer") axferAmount = Number(t.amount);
        }
      }
      if (axferAmount == null) return { label: "FRY amount consistency", passed: false, detail: "No FRY axfer found" };
      var pass = importSum === axferAmount;
      return { label: "FRY amount consistency", passed: pass, detail: "Import sum=" + importSum + " Axfer amount=" + axferAmount + (pass ? " MATCH" : " MISMATCH") };
    }

    async function batchVerifyStakeBoxKeys(p) {
      var rows = [], allPass = true;
      for (var gi = 0; gi < p.groups.length; gi++) {
        var g = p.groups[gi];
        for (var ti = 0; ti < g.txns.length; ti++) {
          var t = g.txns[ti];
          if (t.type === "appl" && t.method === "admin_import_stake") {
            var voteIdHex = (t.args[0] || "").replace(/^hex:/, "");
            var voterAddr = t.args[1];
            var expectedStakeKey = (t.boxes || [])[1];
            if (!voteIdHex || !voterAddr || !expectedStakeKey) { allPass = false; rows.push({ passed: false }); continue; }
            try {
              var voteBytes = batchHexToBytes("hex:" + voteIdHex);
              var voterPk = algosdk.decodeAddress(voterAddr).publicKey;
              var combined = new Uint8Array(voteBytes.length + voterPk.length);
              combined.set(voteBytes, 0); combined.set(voterPk, voteBytes.length);
              var h = await batchSha256Bytes(combined);
              var recomputed = "hex:73" + Array.from(h).map(function(b) { return b.toString(16).padStart(2, "0"); }).join("");
              var pass = recomputed.toLowerCase() === expectedStakeKey.toLowerCase();
              if (!pass) allPass = false;
              rows.push({ passed: pass });
            } catch (e) { allPass = false; rows.push({ passed: false }); }
          }
        }
      }
      if (rows.length === 0) return { label: "Stake box key check", passed: true, detail: "No import stakes in plan" };
      var failCount = rows.filter(function(r) { return !r.passed; }).length;
      return { label: "Stake box key check", passed: allPass, detail: rows.length + " imports \u2014 " + (rows.length - failCount) + " PASS, " + failCount + " FAIL" };
    }

    async function batchVerifyVoteBoxKeys(p) {
      var allPass = true, count = 0;
      for (var gi = 0; gi < p.groups.length; gi++) {
        var g = p.groups[gi];
        for (var ti = 0; ti < g.txns.length; ti++) {
          var t = g.txns[ti];
          if (t.type === "appl" && (t.method === "create_vote" || t.method === "admin_import_stake")) {
            var voteIdHex = (t.args[0] || "").replace(/^hex:/, "");
            var expectedVoteKey = (t.boxes || [])[0];
            if (!voteIdHex || !expectedVoteKey) continue;
            count++;
            if (("hex:76" + voteIdHex).toLowerCase() !== expectedVoteKey.toLowerCase()) allPass = false;
          }
        }
      }
      return { label: "Vote box key check", passed: allPass, detail: count + " vote box references checked" };
    }

    async function batchRunVerification(p) {
      var panel = document.getElementById("batch-verify-panel");
      while (panel.firstChild) panel.removeChild(panel.firstChild);
      var results = [batchVerifyAddresses(p), batchVerifyFryAmounts(p), await batchVerifyStakeBoxKeys(p), await batchVerifyVoteBoxKeys(p)];
      var allPass = true;
      for (var i = 0; i < results.length; i++) {
        var r = results[i];
        if (!r.passed) allPass = false;
        var row = document.createElement("div"); row.style.marginBottom = "0.5rem";
        var badge = document.createElement("span");
        badge.className = "badge " + (r.passed ? "badge-confirmed" : "badge-error");
        badge.textContent = r.passed ? "PASS" : "FAIL";
        row.appendChild(badge);
        row.appendChild(document.createTextNode("  " + r.label + " \u2014 " + r.detail));
        panel.appendChild(row);
      }
      batchVerificationPassed = allPass;
      batchUpdateExecuteButton();
    }

    // --- Batch Plan Rendering ---

    function batchRenderHash(hash) {
      document.getElementById("batch-hash-value").textContent = hash;
      var statusEl = document.getElementById("batch-hash-status");
      while (statusEl.firstChild) statusEl.removeChild(statusEl.firstChild);
      var badge = document.createElement("span");
      badge.className = "badge badge-pending"; badge.textContent = "INFO";
      statusEl.appendChild(badge);
      statusEl.appendChild(document.createTextNode(" Hash recorded"));
      batchHashVerified = true;
      batchUpdateExecuteButton();
    }

    function batchRenderGroups() {
      if (!batchPlan) return;
      document.getElementById("batch-summary-appid").textContent = batchPlan.appId;
      document.getElementById("batch-summary-sender").textContent = batchPlan.sender;
      document.getElementById("batch-summary-network").textContent = batchPlan.network || "mainnet";
      document.getElementById("batch-summary-groups").textContent = batchPlan.groups.length;
      var tbody = document.getElementById("batch-groups-body");
      while (tbody.firstChild) tbody.removeChild(tbody.firstChild);
      batchPlan.groups.forEach(function(g, i) {
        var tr = document.createElement("tr");
        var td1 = document.createElement("td"); td1.textContent = String(i + 1);
        var td2 = document.createElement("td"); td2.textContent = g.description || ("Group " + (i + 1));
        var td3 = document.createElement("td"); td3.textContent = String((g.txns || []).length);
        var td4 = document.createElement("td"); td4.id = "batch-status-" + i;
        var badge = document.createElement("span"); badge.className = "badge badge-pending"; badge.textContent = "Pending";
        td4.appendChild(badge);
        tr.appendChild(td1); tr.appendChild(td2); tr.appendChild(td3); tr.appendChild(td4);
        tbody.appendChild(tr);
      });
    }

    function batchRenderPreview(p) {
      var container = document.getElementById("batch-preview-container");
      while (container.firstChild) container.removeChild(container.firstChild);
      for (var gi = 0; gi < p.groups.length; gi++) {
        var g = p.groups[gi];
        var box = document.createElement("div"); box.className = "operation-info"; box.style.marginBottom = "0.75rem";
        var title = document.createElement("strong"); title.textContent = "Group " + (gi + 1) + ": " + (g.description || "Untitled");
        box.appendChild(title);
        for (var ti = 0; ti < g.txns.length; ti++) {
          var t = g.txns[ti]; var line = document.createElement("div");
          line.style.cssText = "font-size:0.8rem;margin-top:0.25rem;padding-left:1rem;";
          if (t.type === "pay") line.textContent = "Txn " + (ti+1) + ": PAY " + (Number(t.amount)/1e6).toFixed(6) + " ALGO \u2192 " + (t.to ? t.to.substring(0,8) + "..." : "?");
          else if (t.type === "axfer") line.textContent = "Txn " + (ti+1) + ": AXFER " + t.amount + " units (ASA " + t.assetId + ") \u2192 " + (t.to ? t.to.substring(0,8) + "..." : "?");
          else if (t.type === "appl") {
            var argsP = (t.args||[]).map(function(a,idx) { return typeof a==="string"&&a.length>20 ? "arg"+idx+"="+a.substring(0,12)+"..." : "arg"+idx+"="+a; }).join(", ");
            line.textContent = "Txn " + (ti+1) + ": APPL " + (t.method||"?") + "(" + argsP + ")";
          } else line.textContent = "Txn " + (ti+1) + ": " + t.type;
          box.appendChild(line);
        }
        container.appendChild(box);
      }
    }

    function batchSetGroupStatus(i, cls, text) {
      var el = document.getElementById("batch-status-" + i);
      if (!el) return;
      while (el.firstChild) el.removeChild(el.firstChild);
      var badge = document.createElement("span"); badge.className = "badge " + cls; badge.textContent = text;
      el.appendChild(badge);
    }

    function batchUpdateExecuteButton() {
      var btn = document.getElementById("batch-execute-btn");
      btn.disabled = !(connectedAddress && batchPlan && batchPlan.groups && batchPlan.groups.length > 0 && batchVerificationPassed && batchHashVerified);
    }

    // --- Batch Plan Loading ---

    async function batchLoadPlan(rawText) {
      try {
        var hash = await batchComputePlanHash(rawText);
        batchRenderHash(hash);
        log("Plan hash: " + hash);

        var p = JSON.parse(rawText);
        if (!p.appId) throw new Error("Plan missing appId");
        if (!p.sender) throw new Error("Plan missing sender");
        if (!Array.isArray(p.groups)) throw new Error("Plan groups must be an array");

        batchPlan = p;
        batchRenderGroups();
        batchRenderPreview(p);
        log("Plan loaded: " + p.groups.length + " groups", "success");
        await batchRunVerification(p);
      } catch (e) {
        showError("Plan load error: " + e.message);
      }
    }

    // --- Batch Execution ---

    async function batchExecuteAll() {
      if (!connectedAddress || !batchPlan || !peraWallet) return;
      document.getElementById("batch-results-card").style.display = "none";
      hideError();
      document.getElementById("batch-execute-btn").disabled = true;
      var results = [];
      var network = getSelectedNetwork();

      for (var i = 0; i < batchPlan.groups.length; i++) {
        var group = batchPlan.groups[i];
        batchSetGroupStatus(i, "badge-signed", "Signing...");
        log("Group " + (i + 1) + " / " + batchPlan.groups.length + ": " + (group.description || "..."));
        try {
          var algodClient = getAlgodClient(network);
          var sp = await algodClient.getTransactionParams().do();
          var txns = batchBuildGroup(group, sp, batchPlan.appId, connectedAddress);
          log("Group " + (i + 1) + " built, " + txns.length + " txns");

          var result = await signAndSubmit(txns, network);
          log("Group " + (i + 1) + " confirmed in round " + result.confirmedRound, "success");
          batchSetGroupStatus(i, "badge-confirmed", "Confirmed R" + result.confirmedRound);
          results.push({ group: i + 1, txId: result.txId, round: result.confirmedRound });
        } catch (err) {
          log("Group " + (i + 1) + " ERROR: " + (err.message || err), "error");
          batchSetGroupStatus(i, "badge-error", "Error");
          showError("Stopped at group " + (i + 1) + ": " + (err.message || err));
          break;
        }
      }

      var container = document.getElementById("batch-results-container");
      while (container.firstChild) container.removeChild(container.firstChild);
      for (var r = 0; r < results.length; r++) {
        var row = document.createElement("div"); row.className = "result-value"; row.style.fontSize = "0.875rem";
        var link = document.createElement("a");
        link.href = "https://allo.info/tx/" + results[r].txId; link.target = "_blank"; link.textContent = results[r].txId;
        link.style.color = "var(--success)";
        row.appendChild(document.createTextNode("Group " + results[r].group + ": "));
        row.appendChild(link);
        row.appendChild(document.createTextNode(" (round " + results[r].round + ")"));
        container.appendChild(row);
      }
      if (results.length > 0) document.getElementById("batch-results-card").style.display = "";
    }

    // --- Batch Init ---

    async function batchInit() {
      var params = new URLSearchParams(window.location.search);
      var srcParam = params.get("src");
      if (!srcParam) return;

      batchMode = true;
      log("Batch mode: loading plan from ?src=" + srcParam + "...");

      // Build ABI methods map from existing abiSpec
      batchAbiMethods = new Map();
      if (abiSpec && abiSpec.methods) {
        for (var i = 0; i < abiSpec.methods.length; i++) {
          var m = abiSpec.methods[i];
          if (m.name) batchAbiMethods.set(m.name, m);
        }
        log("Batch ABI loaded: " + batchAbiMethods.size + " methods");
      }

      // Hide operations section, show batch section
      if (operationsSectionEl) operationsSectionEl.classList.add("hidden");
      document.getElementById("batch-section").style.display = "";

      // Set network from plan if needed
      try {
        var res = await fetch(srcParam);
        if (!res.ok) throw new Error("HTTP " + res.status);
        var rawText = await res.text();
        await batchLoadPlan(rawText);
      } catch (e) {
        showError("Failed to load plan from ?src=" + srcParam + ": " + e.message);
      }

      // Wire up execute button
      document.getElementById("batch-execute-btn").addEventListener("click", batchExecuteAll);
    }

    // ======================================================================
    // END BATCH PLAN EXECUTION
    // ======================================================================

    try {
      init().catch(err => {
        console.error("[wc-signer] Async init error:", err);
        document.body.innerHTML = `<div style="color:#e74c3c;padding:2rem;font-family:monospace;background:#1a1a2e;">
          <h2>JS Initialization Failed</h2>
          <pre>${err.stack || err.message || err}</pre>
        </div>`;
      });
    } catch (err) {
      console.error("[wc-signer] Sync init error:", err);
      document.body.innerHTML = `<div style="color:#e74c3c;padding:2rem;font-family:monospace;background:#1a1a2e;">
        <h2>JS Initialization Failed</h2>
        <pre>${err.stack || err.message || err}</pre>
      </div>`;
    }
  </script>
</body>
</html>
