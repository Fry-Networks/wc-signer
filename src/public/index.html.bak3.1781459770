        compileGenesisTeal(network, "DistributionPool", "approval"),
        compileGenesisTeal(network, "DistributionPool", "clear"),
      ]);

      log(`Compiled: approval=${approvalRes.size} bytes, clear=${clearRes.size} bytes`);

