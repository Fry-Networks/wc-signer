<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ABI Method Call - FryGovernance</title>
  <style>
    :root {
      --bg-primary: #1a1a2e;
      --bg-secondary: #16213e;
      --bg-card: #0f3460;
      --accent: #e74c3c;
      --accent-hover: #c0392b;
      --text: #eee;
      --text-muted: #888;
      --success: #27ae60;
      --warning: #f39c12;
      --error: #e74c3c;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
      background: var(--bg-primary);
      color: var(--text);
      min-height: 100vh;
      padding: 2rem;
    }

    .container {
      max-width: 700px;
      margin: 0 auto;
    }

    h1 {
      text-align: center;
      margin-bottom: 0.5rem;
      color: var(--accent);
    }

    .subtitle {
      text-align: center;
      color: var(--text-muted);
      margin-bottom: 2rem;
    }

    .card {
      background: var(--bg-secondary);
      border-radius: 12px;
      padding: 1.5rem;
      margin-bottom: 1rem;
    }

    .card-title {
      font-size: 0.875rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.75rem;
    }

    .form-group {
      margin-bottom: 1rem;
    }

    label {
      display: block;
      margin-bottom: 0.5rem;
      color: var(--text-muted);
      font-size: 0.875rem;
    }

    input, select, textarea {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid var(--bg-card);
      border-radius: 6px;
      background: var(--bg-primary);
      color: var(--text);
      font-family: inherit;
      font-size: 0.9rem;
    }

    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: var(--accent);
    }

    textarea {
      min-height: 80px;
      resize: vertical;
      font-family: 'SF Mono', Monaco, 'Courier New', monospace;
    }

    button {
      width: 100%;
      padding: 1rem;
      border: none;
      border-radius: 8px;
      background: var(--accent);
      color: white;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
    }

    button:hover {
      background: var(--accent-hover);
    }

    button:disabled {
      background: var(--bg-card);
      cursor: not-allowed;
    }

    .hidden {
      display: none !important;
    }

    .status {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 0.5rem;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--text-muted);
    }

    .status-dot.connected {
      background: var(--success);
    }

    .status-dot.error {
      background: var(--error);
    }

    .result-value {
      font-family: 'SF Mono', Monaco, 'Courier New', monospace;
      font-size: 0.85rem;
      word-break: break-all;
      background: var(--bg-primary);
      padding: 0.75rem;
      border-radius: 6px;
      margin-top: 0.5rem;
      white-space: pre-wrap;
    }

    .error-message {
      color: var(--error);
      margin-top: 0.5rem;
      font-size: 0.9rem;
    }

    .info-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 0.5rem;
      font-size: 0.9rem;
    }

    .info-label {
      color: var(--text-muted);
    }

    .info-value {
      font-family: 'SF Mono', Monaco, 'Courier New', monospace;
      word-break: break-all;
    }

    #qr-section img {
      max-width: 300px;
      display: block;
      margin: 1rem auto;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>ABI Method Call</h1>
    <p class="subtitle">Call arbitrary ABI methods on deployed FryGovernance contracts</p>

    <div class="card" id="params-card">
      <div class="card-title">Call Parameters</div>
      <div class="info-row">
        <span class="info-label">Network:</span>
        <span class="info-value" id="display-network">-</span>
      </div>
      <div class="info-row">
        <span class="info-label">App ID:</span>
        <span class="info-value" id="display-appid">-</span>
      </div>
      <div class="info-row">
        <span class="info-label">Method:</span>
        <span class="info-value" id="display-method">-</span>
      </div>
      <div class="info-row">
        <span class="info-label">Args:</span>
        <span class="info-value" id="display-args">-</span>
      </div>
    </div>

    <div class="card" id="wallet-card">
      <div class="card-title">Wallet Connection</div>
      <button id="connect-btn">Connect Pera Wallet</button>
      <div class="status hidden" id="wallet-status">
        <div class="status-dot" id="wallet-dot"></div>
        <span id="wallet-text">Not connected</span>
      </div>
    </div>

    <div class="card hidden" id="qr-card">
      <div class="card-title">Scan QR Code with Pera Wallet</div>
      <div id="qr-container"></div>
    </div>

    <div class="card hidden" id="execute-card">
      <div class="card-title">Transaction</div>
      <button id="execute-btn">Build & Sign Transaction</button>
    </div>

    <div class="card hidden" id="result-card">
      <div class="card-title">Result</div>
      <div id="result-container"></div>
    </div>

    <div class="card hidden" id="error-card">
      <div class="card-title">Error</div>
      <div class="error-message" id="error-message"></div>
    </div>
  </div>

  <script src="/bundle.js"></script>
  <script>
    const NETWORK_CONFIG = {
      mainnet: { algodUrl: 'https://mainnet-api.algonode.cloud', chainId: 416001, name: 'Mainnet' },
      testnet: { algodUrl: 'https://testnet-api.algonode.cloud', chainId: 416002, name: 'Testnet' },
      localnet: { algodUrl: 'http://localhost:4001', chainId: 416002, name: 'Localnet' }
    };

    const { PeraWalletConnect, sha512_256 } = window;
    const algosdk = window.algosdk;

    let peraWallet = null;
    let walletAddress = null;
    let currentNetwork = null;
    let currentAppId = null;
    let currentMethod = null;
    let currentArgs = [];
    let unsignedTxnBase64 = null;

    function getUrlParams() {
      const params = new URLSearchParams(window.location.search);
      return {
        network: params.get('network') || 'testnet',
        appId: params.get('appId'),
        method: params.get('method'),
        args: params.get('args'),
        accounts: params.get('accounts'),
        assets: params.get('assets'),
        boxes: params.get('boxes')
      };
    }

    function showError(msg) {
      const el = document.getElementById('error-card');
      document.getElementById('error-message').textContent = msg;
      el.classList.remove('hidden');
    }

    function hideError() {
      document.getElementById('error-card').classList.add('hidden');
    }

    function setWalletStatus(connected, text) {
      const status = document.getElementById('wallet-status');
      const dot = document.getElementById('wallet-dot');
      const label = document.getElementById('wallet-text');
      status.classList.remove('hidden');
      dot.className = 'status-dot' + (connected ? ' connected' : '');
      label.textContent = text;
    }

    function createInfoRow(labelText, valueText, color) {
      const row = document.createElement('div');
      row.className = 'info-row';
      const label = document.createElement('span');
      label.className = 'info-label';
      label.textContent = labelText;
      const value = document.createElement('span');
      value.className = 'info-value';
      value.textContent = valueText;
      if (color) value.style.color = color;
      row.appendChild(label);
      row.appendChild(value);
      return row;
    }

    async function init() {
      const params = getUrlParams();
      currentNetwork = params.network;
      currentAppId = params.appId;
      currentMethod = params.method;

      if (!currentAppId || !currentMethod) {
        showError('Missing required URL parameters: appId and method');
        return;
      }

      try {
        currentArgs = params.args ? JSON.parse(params.args) : [];
      } catch (e) {
        showError('Failed to parse args JSON: ' + e.message);
        return;
      }

      document.getElementById('display-network').textContent = currentNetwork;
      document.getElementById('display-appid').textContent = currentAppId;
      document.getElementById('display-method').textContent = currentMethod;
      document.getElementById('display-args').textContent = JSON.stringify(currentArgs);

      peraWallet = new PeraWalletConnect({
        chainId: NETWORK_CONFIG[currentNetwork].chainId
      });

      peraWallet.connector?.on('connect', () => {
        document.getElementById('qr-card').classList.add('hidden');
      });

      peraWallet.connector?.on('disconnect', () => {
        walletAddress = null;
        setWalletStatus(false, 'Disconnected');
        document.getElementById('execute-card').classList.add('hidden');
      });
    }

    async function connectWallet() {
      hideError();
      try {
        const accounts = await peraWallet.connect();
        walletAddress = accounts[0];
        setWalletStatus(true, 'Connected: ' + walletAddress);
        document.getElementById('connect-btn').textContent = 'Wallet Connected';
        document.getElementById('connect-btn').disabled = true;
        document.getElementById('execute-card').classList.remove('hidden');
      } catch (err) {
        showError('Wallet connection failed: ' + (err.message || err));
      }
    }

    document.getElementById('connect-btn').addEventListener('click', connectWallet);

    async function buildAndSign() {
      hideError();
      document.getElementById('result-card').classList.add('hidden');

      if (!walletAddress) {
        showError('Wallet not connected');
        return;
      }

      try {
        const params = getUrlParams();
        const body = {
          network: currentNetwork,
          appId: currentAppId,
          sender: walletAddress,
          method: currentMethod,
          args: currentArgs,
        };

        if (params.accounts) {
          body.accounts = params.accounts.split(',').map(s => s.trim()).filter(Boolean);
        }
        if (params.assets) {
          body.assets = params.assets.split(',').map(s => parseInt(s.trim(), 10)).filter(n => !isNaN(n));
        }
        if (params.boxes) {
          body.boxes = JSON.parse(params.boxes);
        }

        const buildRes = await fetch('/api/build-abi-call', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });

        if (!buildRes.ok) {
          const err = await buildRes.text();
          throw new Error('Build failed: ' + err);
        }

        const buildData = await buildRes.json();
        unsignedTxnBase64 = buildData.unsignedTxn;
        const unsignedTxnBytes = Uint8Array.from(atob(buildData.unsignedTxn), c => c.charCodeAt(0));

        const signedTxns = await peraWallet.signTransaction([[{
          txn: algosdk.decodeUnsignedTransaction(unsignedTxnBytes),
          signers: [walletAddress]
        }]]);

        const signedTxnBase64 = btoa(String.fromCharCode(...new Uint8Array(signedTxns[0])));

        const submitRes = await fetch('/api/submit-signed', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ signedTxn: signedTxnBase64 })
        });

        const submitData = await submitRes.json();
        if (!submitRes.ok || submitData.error) {
          throw new Error(submitData.error || 'Submission failed');
        }

        const resultContainer = document.getElementById('result-container');
        resultContainer.textContent = '';
        resultContainer.appendChild(createInfoRow('Status:', 'Success', 'var(--success)'));
        resultContainer.appendChild(createInfoRow('TXID:', submitData.txid, null));
        resultContainer.appendChild(createInfoRow('Round:', String(submitData.confirmedRound), null));
        if (submitData.appId) {
          resultContainer.appendChild(createInfoRow('App ID:', String(submitData.appId), null));
        }
        document.getElementById('result-card').classList.remove('hidden');

      } catch (err) {
        showError(err.message || String(err));
      }
    }

    document.getElementById('execute-btn').addEventListener('click', buildAndSign);

    window.addEventListener('load', init);
  </script>
</body>
</html>
